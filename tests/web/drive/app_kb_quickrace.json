 { "press": "Shift+Tab" },
 { "press": "Enter" },
 { "sleep": 400 },
 { "eval": "({ menuOpen: document.querySelector('#menu').open, inputEventsAfterMenu: window.__nfsu2.session.stats()['input events'] })" },
 { "press": "Enter", "until": "UI_QRModeSelect\\.fng", "every": 2500, "timeout": 30000 },
