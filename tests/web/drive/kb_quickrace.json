[
 { "log": "title -> profile prompt -> main menu with the real (trusted) keyboard" },
 { "wait": "top package UG_LS_Splash", "timeout": 120000 },
 { "log": "suspend the AudioContext (as Chrome does before a user gesture), then press a real key" },
 { "eval": "__nfsu2.audio.context.suspend().then(() => __nfsu2.audio.context.state)" },
 { "sleep": 500 },
 { "eval": "__nfsu2.audio.status().mode" },
 { "press": "Enter", "until": "screen MC_Background\\.fng", "every": 1500, "timeout": 60000 },
 { "eval": "__nfsu2.audio.context.state" },
 { "sleep": 3000 },
 { "press": "Enter", "until": "GarageMain\\.fng", "every": 2500, "timeout": 30000 },
 { "sleep": 2500 },
 { "mouse": [  640,  360 ] },
 { "eval": "__nfsu2.input.status().cursor" },
 { "mouse": [  1180,  700 ] },
 { "eval": "__nfsu2.input.status().cursor" },
 { "eval": "__nfsu2.audio && __nfsu2.audio.status().state" },
 { "press": "Enter", "until": "UI_QRModeSelect\\.fng", "every": 2500, "timeout": 30000 },
 { "sleep": 1500 },
 { "press": "Enter", "until": "UI_QRTrackSelect\\.fng", "every": 2500, "timeout": 30000 },
 { "sleep": 1500 },
 { "press": "Enter", "until": "UI_QRModeOptions\\.fng", "every": 2500, "timeout": 30000 },
 { "sleep": 1500 },
 { "press": "Enter", "until": "UI_QRCarSelect\\.fng", "every": 2500, "timeout": 30000 },
 { "sleep": 1500 },
 { "press": "Enter", "until": "PC_Loading\\.fng", "every": 2500, "timeout": 30000 },
 { "wait": "race: observing input", "timeout": 120000 },
 { "log": "hold W (throttle)" },
 { "down": "KeyW" },
 { "sleep": 3000 },
 { "log": "and ArrowLeft (steer left)" },
 { "down": "ArrowLeft" },
 { "sleep": 1500 },
 { "up": "ArrowLeft" },
 { "log": "released ArrowLeft" },
 { "sleep": 1500 },
 { "up": "KeyW" },
 { "log": "released W" },
 { "wait": "observation over", "timeout": 60000 }
]