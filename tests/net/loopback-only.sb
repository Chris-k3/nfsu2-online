;; loopback-only.sb -- sandbox-exec profile for network tests of the port.
;; Everything is allowed except IP networking beyond 127.0.0.1: outgoing
;; connections and datagrams, binds and inbound traffic on any other address
;; are refused by the kernel (EPERM).  AF_UNIX (the vlan hub) is not IP and
;; stays allowed.  Note: bind(0.0.0.0) is NOT refused by this profile, which
;; is why the HLE's loopback guard rewrites wildcard binds to 127.0.0.1 itself.
;;   sandbox-exec -f tests/net/loopback-only.sb out/nfsu2_boot ...
(version 1)
(allow default)
(deny network-outbound (remote ip "*:*"))
(allow network-outbound (remote ip "localhost:*"))
(deny network-bind (local ip "*:*"))
(allow network-bind (local ip "localhost:*"))
(deny network-inbound (local ip "*:*"))
(allow network-inbound (local ip "localhost:*"))
